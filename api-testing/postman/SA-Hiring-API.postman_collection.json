        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_reference\": \"portfolio-test-file.pdf\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/candidates/{{candidate_id}}/documents/{{document_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "candidates",
            "{{candidate_id}}",
            "documents",
            "{{document_id}}"
          ]
        }
      }
    }
